# FCR Dashboard - Git ignore rules
# Generated files only. Batch scripts, the SQLite database, JSON settings,
# the PyInstaller spec, version_info.txt, static and tests are deliverables
# and stay tracked.

# Python bytecode and packaging metadata
__pycache__/
*.py[cod]
*$py.class
*.egg-info/

# Virtual environments
.venv/
venv/
env/
ENV/

# Local secrets / environment overrides
.env
.env.*

# PyInstaller and archive build output
build/
dist/
*.exe
*.zip
FCR_Dashboard.zip

# Runtime data written beside the executable
logs/
backups/
exports/
*.log

# Test, coverage and type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Editors
.vscode/
.idea/

# Operating system metadata
.DS_Store
Thumbs.db
desktop.ini
