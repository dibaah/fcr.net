{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "Fcr": {
    "DataDir": "/var/lib/fcr/data",
    "BackupLocation": "/var/lib/fcr/backups",
    "AttachmentRoot": "/var/lib/fcr/attachments"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://127.0.0.1:8080"
      }
    }
  }
}
